# EmbedderCrux pool router — load balances across embedding backends.
#
# Chainguard base per ExecPlan chainguard-image-migration (M4).
#
# src/discovery.mjs:110 shells out to `tailscale status --json` at runtime, so
# the CLI has to be present in the final image. The Chainguard node runtime has
# no apk and no shell, so the package is installed in a wolfi-base stage (same
# apk feed, same glibc userland) and only the CLI binary is copied across. The
# daemon (tailscaled) is deliberately not copied: it runs in the sidecar
# container this service shares a netns with (docker-compose.pool.yml:2-29),
# never in here, so shipping it would only add ~33 MB of unused attack surface.
FROM cgr.dev/chainguard/wolfi-base:latest AS tailscale-cli
USER root
RUN apk add --no-cache tailscale

FROM cgr.dev/chainguard/node:latest

# Replaces `RUN apk add --no-cache tailscale` — no apk, no shell in this image.
COPY --from=tailscale-cli /usr/bin/tailscale /usr/bin/tailscale

WORKDIR /app

COPY package.json ./package.json
COPY src/pool-router.mjs src/discovery.mjs src/health-checker.mjs src/pool-metrics.mjs ./src/

ENV NODE_ENV=production
ENV POOL_ROUTER_PORT=8079

EXPOSE 8079

# Base ENTRYPOINT is /usr/bin/node; reset it so the exec-form CMD is not
# expanded into `node node src/pool-router.mjs`.
ENTRYPOINT []
CMD ["node", "src/pool-router.mjs"]
